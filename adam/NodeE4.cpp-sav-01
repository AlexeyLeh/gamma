        //// TODO     if( m_temperature_value > m_plato_hot_mode_temp )
        //// TODO     {
        //// TODO         QString msg = QString("%1%2C > %3%4C - %5")
        //// TODO                       .arg( m_temperature_value, 0, 'f', 1 )
        //// TODO                       .arg( QChar(Qt::Key_degree) )
        //// TODO                       .arg( m_plato_hot_mode_temp )
        //// TODO                       .arg( QChar(Qt::Key_degree) )
        //// TODO                       .arg( "WRONG TEMPERATURE MODE" );
        //// TODO         showstatus( msg );
        //// TODO     }
        //// TODO }
        //// TODO else
        //// TODO {
