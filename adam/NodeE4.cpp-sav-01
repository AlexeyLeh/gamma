void NodeE4::response_0xf1(const Adam::Response &response) // Read/Write Master Status Register
{
    // [F1] Read/Write Master Status Register
    // [RTIME]=200
    // [CTYPE]=3
    // ;
    // L MSR,N/A;Master status Registar
    // ;
    // ;The Master Status Register is a 32-bit register that is maintained by the Bus Master.  The
    // ;Bus Master will broadcast (transmit to node <0x03>) this register whenever it changes.  Since
    // ;this is a broadcast message and slave nodes do not respond, it is sent three times with a 250
    // ;millisecond delay between each message.  This is to decrease the possibility of a slave node
    // ;not receiving it.
    // ;
    // ;The Master Status Register:
    // ;
    // ;Bit 31:  Master State
    // ;   1= The Bus Master is running tasks that require data from slave nodes. When this
    // ;   bit is set, and the rotation state match the log requirement in the recorder task
    // ;   record is match, the firmware will put the node into power management mode.
    // ;   0= The Bus Master is not running any tasks which require slave node data.
    // ;   Whenever the slave node receive the MSR with this bit clear, it will shut down the
    // ;   power management function.
    // ;Bit 30:  Flow State
    // ;   1= Flow On has been detected by the Bus Master.
    // ;   0= Flow Off has been detected by the Bus Master.
    // ;Bit 29:  Rotation State
    // ;   1= Rotation has been detected by the Bus Master.
    // ;   0= Rotation has not been detected by the Bus Master.
    // ;Bit 28:  Inclination State
    // ;   1= High Inclination has been detected by the Bus Master.
    // ;   0= Low Inclination has been detected by the Bus Master.
    // ;Bit 27 - Bit 0
    // ;   Unassigned
    // ;Read Master Status Register
    // ;Requests the node transmit its copy of the MSR.
    // ;
    // ;Tx = <msg header> <0xF1> <chksum>
    // ;
    // ;Rx = <msg header> <0xF1> <cmd ack> <slave status> <MSR> <chksum>
    // ;<cmd ack>::= <0x00>
    // ;<MSR>::= <MSByte> <byte> <byte> <LSByte>
    // ;
    // ;
    // ; Write Master Status Register
    // ;Commands the node to update its copy of the MSR and take whatever action is required. This
    // ;command normally is broadcast by the Master node.
    // ;
    // ;Tx = Command
    // ;<msg header> <0xF1> <MSR> <chksum>
    // ;<MSR> ::= <MSByte> <byte> <byte> <LSByte>
    // ;
    // ;Slave nodes do not respond to Broadcast Messages.

    if (response.payload_size() < 4)
    {
        qDebug() << "INCORRECT RESPONSE - expected data size at least 4 but got " << response.payload_size();
        return;
    }
        const auto& data = response.payload();
        uint32_t value = 0;
        value |= data.at(0);
        value <<= 8;
        value |= data.at(1);
        value <<= 8;
        value |= data.at(2);
        value <<= 8;
        value |= data.at(3);

        auto txt = QString( "%1" ).arg( value, 0, 16 ).toUpper();
        //// TODO m_setup_statusreg->setText( QStringLiteral("0x") + txt.toUpper() );
        //// TODO QString tip = tr( "Bit 31:  Master State"
        //// TODO                       "   1 = The Bus Master is running tasks that require data from slave nodes. When this\n"
        //// TODO                       "   bit is set, and the rotation state match the log requirement in the recorder task\n"
        //// TODO                       "   record is match, the firmware will put the node into power management mode.\n"
        //// TODO                       "   0 = The Bus Master is not running any tasks which require slave node data.\n"
        //// TODO                       "   Whenever the slave node receive the MSR with this bit clear, it will shut down the\n"
        //// TODO                       "   power management function.\n"
        //// TODO                       "Bit 30:  Flow State\n"
        //// TODO                       "   1 = Flow On has been detected by the Bus Master.\n"
        //// TODO                       "   0 = Flow Off has been detected by the Bus Master.\n"
        //// TODO                       "Bit 29:  Rotation State\n"
        //// TODO                       "   1 = Rotation has been detected by the Bus Master.\n"
        //// TODO                       "   0 = Rotation has not been detected by the Bus Master.\n"
        //// TODO                       "Bit 28:  Inclination State\n"
        //// TODO                       "   1 = High Inclination has been detected by the Bus Master.\n"
        //// TODO                       "   0 = Low Inclination has been detected by the Bus Master.\n"
        //// TODO                       "Bit 27 - Bit 0\n"
        //// TODO                       "   Unassigned\n" );
        //// TODO m_setup_statusreg->setToolTip( tip );

        //// TODO QByteArray ba( "Master Status Reg:" );
        //// TODO ba += txt.toUtf8() + QByteArrayLiteral("\n");
        //// TODO m_terminal->put_data( ba );
        qDebug() << "    Master Status Register:" << QString::number(txt, 16);
        //// m_gui->upload_setup_xxx(value);
}

void NodeE4::response_0xf8(const Adam::Response &response) // Read Record Task
{
    // ;Tx = <msg header> <0xF8> <cmd ext> <chksum>
    // ;<cmd ext> ::= <0x01> | <0x05> | <0x06>
    // ;
    // ;Rx = <msg header> <0xF8> <cmd ext> <init delay> <period> <records> <buckets> <log mode> <chksum>
    // ;<cmd ext>  ::= <0x01> | <0x05> | <0x06>
    // ;<init delay>   ::= <MSByte> <LSByte>
    // ;<period>   ::= <MSByte> <LSByte>
    // ;<records>  ::= <byte>
    // ;<buckets>  ::= <byte>
    // ;<log mode> ::= <byte>
    // ;<cmd ack>  ::= <0x00> | <0xFD>
    // ;
    // ;Write Recorder Task
    // ;Tx = <msg header> <0xF8> <cmd ext> <init delay> <period> <records> <buckets> <log mode> <chksum>
    // ;<cmd ext>  ::= <0x01> | <0x05> | <0x06>
    // ;<init delay>   ::= <MSByte> <LSByte>
    // ;<period>   ::= <MSByte> <LSByte>
    // ;<records>  ::= <byte>
    // ;<buckets>  ::= <byte>
    // ;<log mode> ::= <byte>
    // ;
    // ;Rx = <msg header> <0xF8> <cmd ack> <slave status> <chksum>
    // ;<cmd ack> ::= <0x00> | <0xFD>

    //// TODO m_flddiag_rectask_cmd->setText( stuff_cmdhex );
    //// TODO m_flddiag_rectask_ms ->setText( stuff_elapsed_time );

    if (response.payload_size() < 8)
    {
        qDebug() << "INCORRECT RESPONSE - expected data size at least 8 but got " << response.payload_size();
        return;
    }
        const auto& data = response.payload();
        auto ext = data.at(0);
        if (ext == 1 || ext == 5 || ext == 6)
        {
            //<init delay> <period> <records> <buckets> <log mode>
            ushort initdelay = (data.at(1) << 8) | data.at(2);
            ushort period    = (data.at(3) << 8) | data.at(4);
            byte   records   = data.at(5);
            byte   buckets   = data.at(6);
            byte   logmode   = data.at(7);

            //// TODO auto txt = QStringLiteral("<%1> init:%2 period:%3 recs:%4 buckets:%5 log:%6")
            //// TODO       .arg(ext)
            //// TODO       .arg(initdelay)
            //// TODO       .arg(period)
            //// TODO       .arg(records)
            //// TODO       .arg(buckets)
            //// TODO       .arg(logmode);
            //// TODO QByteArray ba("Record Task: ");
            //// TODO ba += txt.toUtf8() + QByteArrayLiteral("\n");
            //// TODO m_terminal->put_data( ba );
            auto txt = QStringLiteral("[%1] %2s %3s %4 %5 %6")
                       .arg(ext)
                       .arg(initdelay/10.0)
                       .arg(period/10.0)
                       .arg(records)
                       .arg(buckets)
                       .arg(logmode);
            //// TODO m_flddiag_rectask->setText( txt );

            //// TODO if( m_flddiag_rectask_log->isChecked() )
            //// TODO     write_term_protocol_record( txt, -12 );
            qDebug() << "    Record Task:" << txt;
        }
}

