    if (response.payload_size() < 5)
    {
        qDebug() << "INCORRECT RESPONSE - expected data size at least 5 but got " << response.payload_size();
        return;
    }
        const auto& data = response.payload();
        auto ext = static_cast<AvgType>(data.at(0));
        if (ext >= 1 && ext <= 3)
        {
            //// m_gui->update_cv_gz(m_accelerometer_corrected_data.Gz);

            int i = ext-1;
            auto value = Adam::decode_ieee754(data.data()+1, data.size()-1);
            m_accelerometer_corrected_value[i] = value;
            //// TODO txt = QStringLiteral("%1  %2  %3")
            //// TODO         .arg(m_accelerometer_corrected_value[0], 0, 'f', 6 )
            //// TODO         .arg(m_accelerometer_corrected_value[1], 0, 'f', 6 )
            //// TODO         .arg(m_accelerometer_corrected_value[2], 0, 'f', 6 );
            //// TODO m_flddiag_GzCorr->setText( txt );
            //// TODO m_flddiag_GzCorr->setToolTip( txt );
            //// TODO m_setup_Gz_Corr->setText( QString::number(m_accelerometer_corrected_value[AvgType::Medium], 'f', 6 ) );
            //// TODO QByteArray ba( "Acc corr:" );
            //// TODO ba += txt.toUtf8() + QByteArrayLiteral("\n");
            //// TODO m_terminal->put_data( ba );
            //// TODO if( m_flddiag_GzCorr_log->isChecked() )
