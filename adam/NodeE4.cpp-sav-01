void NodeE4::response_0x46(const Adam::Response &response) // Read/Write HVPS Warm-up
{
    // [46] Read/Write HVPS Warm-up
    // [RTIME]=200
    // [CTYPE]=3
    // ;
    // B wm up,10ths sec;HVPS Warm-up is the delay between turning on the HVPS and starting an
    // ;	acquisition.  Units are tenths of a second and limits are 0.0s to 10.0s.  It is read from
    // ;	and written to non-volatile memory.
    // !!! замечание от программиста - значение считывается в секундах, а не в 10ths !!!
    // ;
    // ;Read HVPS Warm-up
    // ;
    // ;Tx = <msg header> <0x46> <chksum>
    // ;
    // ;Rx = <msg header> <0x46> <cmd ack> <slave status> <warm-up> <chksum>
    // ;<cmd ack>	::= <0x00>
    // ;<warm-up>	::= <hex byte>
    // ;
    // ;Write HVPS Warm-up
    // ;This command instructs the node to change the HVPS warm-up time.  If warm-up is outside the
    // ;limits, an <0xFD> cmd ack will be returned and it will be set to the appropriate limit.
    // ;
    // ;Tx = <msg header> <0x46> <warm-up> <chksum>
    // ;<warm-up> ::= <hex byte>
    // ;
    // ;Rx = <msg header> <0x46> <cmd ack> <slave status> <chksum>
    // ;<cmd ack> ::= <0x00> | <0xFD>

    //// TODO m_flddiag_HVPS_warm_cmd->setText( stuff_cmdhex );
    //// TODO m_flddiag_HVPS_warm_ms ->setText( stuff_elapsed_time );
    if (response.payload_size() < 1)
    {
        qDebug() << "INCORRECT RESPONSE - expected data size at least 1 but got " << response.payload_size();
        return;
    }
        byte num = response.payload_byte();
        m_acq_warmup = num*0.1;
        qDebug("NodeE4 '%s', status:0x%04X, HVPS Warm-up: %d (%d sec)", name().c_str(), status(), num, m_acq_warmup);

        //// TODO m_flddiag_HVPS_warm_cmd->setText( stuff_cmdhex );
        //// TODO m_flddiag_HVPS_warm_ms ->setText( stuff_elapsed_time );
        //// TODO m_flddiag_HVPS_warm->setText( QString::number( m_acq_warmup, 'f', 1 ) );

        //// TODO txt = QString("%1%2 (%3 %4)").arg(tr( "Acq WarmUp:")).arg(num).arg( m_acq_warmup, 0, 'f', 1).arg( tr("sec"));
        //// TODO m_terminal->put_data_ln( txt.toUtf8() );
        //// TODO m_setup_warmuptime->setText( QString::number( num ) );
        //// TODO m_setup_warmuptime->setToolTip( txt );
        //// TODO if( m_flddiag_HVPS_warm_log->isChecked() )
        //// TODO     write_term_protocol_record( QString::number( m_acq_warmup, 'f', 1 ), -12 );
}

void NodeE4::response_0x50(const Adam::Response &response) // Read/Write CTABLE
{
    // [50] Read/Write CTABLE
    // [RTIME]=200
    // [CTYPE]=3
    // X CS,N/A;Check Sum
    // A11 PN,N/A;Part Number
    // F Ksfz0,N/A;Scale Factor
    // F Ksfz1,N/A;Scale Factor
    // F Ksfz2,N/A;Scale Factor
    // F Ksfz3,N/A;Scale Factor
    // F Kbz0,N/A;Bias Constant
    // F Kbz1,N/A;Bias Constant
    // F Kbz2,N/A;Bias Constant
    // F Kbz3,N/A;Bias Constant
    // A7 Acc SN,N/A;Accelerometer Serial Number
    // A8 Date,N/A;Date
    // A5 Time,N/A;Time
    // A15 Res,N/A;Reserved
    // ;
    // ;The CTABLE is used to calibrate the Accelerometer and is a 80 bytes long table, therefore,
    // ;the CTABLE should be written into the EEPROM memory of the MCU prior to the operation in order
    // ;to get the correct inclination data. The format of the CTABLE is listed as follows
    // ;
    // ;Field name				Data type	Length	Default value
    // ;_____________________________________________________________________
    // ;Check sum				ushrt		2		*
    // ;Part number			char		11		77557TE100
    // ;Scale factor - Ksfz0	float		4		0.0
    // ;Scale factor - Ksfz1	float		4		1.0
    // ;Scale factor - Ksfz2	float		4		0.0
    // ;Scale factor - Ksfz3	float		4		0.0
    // ;Bias constant - Kbz0	float		4		0.0
    // ;Bias constant - Kbz1	float		4		1.0
    // ;Bias constant - Kbz2	float		4		0.0
    // ;Bias constant - Kbz3	float		4		0.0
    // ;Accelerometer S/N  	    char        7       *
    // ;Date					char		8		*
    // ;Time					char		5		*
    // ;Reserved				char		15		*
    // ;
    // ;Read CTABLE
    // ;This command instructs the node to return the CTABLE which is stored in the MCU's EEPROM memory.
    // ;Tx = <msg header> <0x50> <chksum>
    // ;Rx = <msg header> <0x50> <cmd ack> <slave status> <CTABLE> <chksum>
    // ;<cmd ack>	::= <0x00>
    // ;<CTABLE>	::= <Table of 80 bytes>
    // ;
    // ; Write CTABLE
    // ;This command instructs the node to change the contents of the CTABLE.
    // ;Tx = <msg header> <0x50> <CTABLE> <chksum>
    // ;<CTABLE> ::= <Table of 80 bytes>
    // ;Rx = <msg header> <0x50> <cmd ack> <slave status> <chksum>
    // ;<cmd ack> ::= <0x00> | <0xFD>

    if (response.payload_size() < 80)
    {
        qDebug() << "INCORRECT RESPONSE - expected data size at least 80 but got " << response.payload_size();
        return;
    }
        m_ctable = response.payload();
        auto txt = QString( "Accel CTable - size:%1 CRC:%2 (0x%3) PN:%4\n"
                            "%5 %6 %7 %8\n"
                            "%9 %10 %11 %12\n"
                            "SN:%13\nDate:%14 Time:%15" )
                   .arg(data.size())
                   .arg(m_ctable.m_check_sum)
                   .arg(m_ctable.m_check_sum, 4, 16, QChar('0'))
                   .arg(m_ctable.m_part_number)
                   .arg(m_ctable.m_scale_Ksfz0, 0, 'f', 8)
                   .arg(m_ctable.m_scale_Ksfz1, 0, 'f', 8)
                   .arg(m_ctable.m_scale_Ksfz2, 0, 'f', 8)
                   .arg(m_ctable.m_scale_Ksfz3, 0, 'f', 8)
                   .arg(m_ctable.m_bias_Kbz0,   0, 'f', 8)
                   .arg(m_ctable.m_bias_Kbz1,   0, 'f', 8)
                   .arg(m_ctable.m_bias_Kbz2,   0, 'f', 8)
                   .arg(m_ctable.m_bias_Kbz3,   0, 'f', 8)
                   .arg(m_ctable.m_accel_SN)
                   .arg(m_ctable.m_date)
                   .arg(m_ctable.m_time);
        //// TODO m_terminal->put_data_ln(txt.toUtf8());
        //if( m_flddiag_HVPS_warm_log->isChecked() )
        //    write_term_protocol_record( QString::number( m_acq_warmup, 'f', 1 ), -12 );
        m_gui->refresh_ctable();
        qDebug() << "    CTable:" << txt;
}

void NodeE4::response_0x51(const Adam::Response &response) // Read/Write Local Gravity
{
    // [51] Read/Write Local Gravity
    // [RTIME]=200
    // [CTYPE]=3
    // ;
    // F local,N/A;local gravity, The local gravity is stored in the MCU's EEPROM memory which is used
    // ;to calculate the inclination. In most places, this number should be 1.00 where some other places
    // ;might have silghtly different from 1.00.  The local gravity should also be written into the
    // ;EEPROM when calibrate the SRIG in order to get the correct inclination data during operation.
    // ;
    // ;Read  Local Gravity
    // ;Tx = <msg header> <0x51> <chksum>
    // ;Rx = <msg header> <0x51> <cmd ack> <slave status> <local gravity> <chksum>
    // ;<cmd ack>  ::= <0x00>
    // ;<local gravity>    ::= <IEEE FP>
    // ;
    // ;Write Local Gravity
    // ;This command instructs the node to change the local gravity.
    // ;Tx = <msg header> <0x51> <local gravity> <chksum>
    // ;<local gravity> ::= <IEEE FP>
    // ;Rx = <msg header> <0x51> <cmd ack> <slave status> <chksum>
    // ;<cmd ack> ::= <0x00> | <0xFD>

    if (response.payload_size() < 4)
    {
        qDebug() << "INCORRECT RESPONSE - expected data size at least 4 but got " << response.payload_size();
        return;
    }
        const auto& data = response.payload();
        auto value = (double)TOOLS::decode_ieee754(data);
        m_gravity = value;
        //// TODO txt = QString::number(value, 'f', 6);
        //// TODO m_setup_grav_field->setText( txt );
        //// TODO m_terminal->put_data_ln( QByteArrayLiteral("Local gravity field: ") + txt.toLocal8Bit() );
        //// TODO if( m_flddiag_gravity_log->isChecked() )
        //// TODO     write_term_protocol_record( txt.toLocal8Bit(), -12 );
        qDebug("    gravity: %f", value);
}

void NodeE4::response_0x1e(const Adam::Response &response) // Read the MCU's A/D converter
{
    // ;Tx = <msg header> <0x1E> <cmd ext> <chksum>
    // ;<cmd ext> ::= <0x00>..<0x07>
    // ;
    // ;Each command extension related to one analog signal. The current SRIG board design for the
    // ;analog input and the relation to the command extension is shown as follows.
    // ;
    // ;<0x00>	: +15 VDC signal.
    // ;<0x01>	: +5 VDC signal.
    // ;<0x02>	: DV485 signal.
    // ;<0x03>	: High voltage control signal.
    // ;<0x04>	: Temperature sensor signal.
    // ;<0x05>	: Temperature circuit calibration signal.
    // ;<0x06>	: 2.5V reference signal.
    // ;<0x07>	: Power supply current.
    //
    // ;Rx = <msg header> <0x1E> <cmd ack> <slave status> <cmd ext> <ADC reading> <chksum>
    // ;<cmd ack> 	::= <0x00> | <0xFD>
    // ;<cmd ext> 	::= <0x00>..<0x07>
    // ;<ADC reading>	::= <IEEE FP>

    if (response.payload_size() < 5)
    {
        qDebug() << "INCORRECT RESPONSE - expected data size at least 5 but got " << response.payload_size();
        return;
    }

    const auto& data = response.payload();
    auto ext = static_cast<AdcSignal>(data.at(0));
    if( ext >= 0 && ext <= 7 )
    {
        //// TODO m_flddiag_ADC_cmd[ext]->setText(cCmdHex);
        //// TODO m_flddiag_ADC_ms[ext] ->setText(cElapsedTime);
    }

    auto value = Adam::decode_ieee754(data.data()+1, data.size()-1);
    qDebug() << "nodeE4: analog" << (int)ext << "-" << value;

    //// TODO m_setup_ADC[ext]->setText(QString::number(value, 'f', 4));

    switch (ext)
    {
        case NodeE4::AdcSignal::Vdc15:
            m_voltage15 = value;
            //// m_gui->update_cv_analog_vdc15(voltage15);
            //// m_gui->update_setup_analog_vdc15(voltage15);
            break;

        case NodeE4::AdcSignal::Vdc5:
            m_voltage5 = value;
            //// m_gui->update_cv_analog_vdc5(voltage5);
            //// m_gui->update_setup_analog_vdc5(voltage5);
            break;

        case NodeE4::AdcSignal::Dv485:
            m_dv485 = value;
            //// m_gui->update_cv_analog_dv485(dv485);
            //// m_gui->update_setup_analog_dv485(dv485);
            break;

        case NodeE4::AdcSignal::HighVoltageControl:
            m_high_voltage_control = value;
            //// m_gui->update_cv_analog_high_voltage(high_voltage_control);
            //// m_gui->update_setup_analog_high_voltage(high_voltage_control);
            break;

        case NodeE4::AdcSignal::TempSensor:
            m_temperature_sensor = value;
            //// m_gui->update_cv_analog_temp_sensor_voltage(temperature_sensor);
            //// m_gui->update_setup_analog_temp_sensor_voltage(temperature_sensor);
            break;

        case NodeE4::AdcSignal::TempCircuitCalibration:
            m_temperature_circuit_calibration = value;
            //// m_gui->update_cv_analog_temperature_calibration_voltage(temperature_circuit_calibration);
            //// m_gui->update_setup_analog_temperature_calibration_voltage(temperature_circuit_calibration);
            break;

        case NodeE4::AdcSignal::Vdc25Reference:
            m_vdc25_reference = value;
            //// m_gui->update_cv_analog_ref_voltage(vdc25_reference);
            //// m_gui->update_setup_analog_ref_voltage(vdc25_reference);

        case NodeE4::AdcSignal::PowerSupplyAmperage:
            m_power_amperage = value;
            //// m_gui->update_cv_analog_power_amperage(power_amperage);
            //// m_gui->update_setup_analog_power_amperage(power_amperage);
    }

}

