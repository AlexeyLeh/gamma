#include <QtDebug>

#include "NodeE4.h"

#include "srig_gui.h"

NodeE4::NodeE4() :
    NODE(0xE4, "SRIG"),
    m_gui(0)
{
    m_requests =
            std::list<Adam::Frame> {
            ReadAccelerometerInclinationData(),
            ReadAccelerometerRawData(),
            ReadAccelerometerCorrectedData(),
            ReadTemperature(),
            ReadGammaRayData(),
            ReadAdcSignal(AdcSignal::Vdc15),
            ReadAdcSignal(AdcSignal::Vdc5),
            ReadAdcSignal(AdcSignal::Dv485),
            ReadAdcSignal(AdcSignal::HighVoltageControl),
            ReadAdcSignal(AdcSignal::TempSensor),
            ReadAdcSignal(AdcSignal::TempCircuitCalibration),
            ReadAdcSignal(AdcSignal::Vdc25Reference),
            ReadAdcSignal(AdcSignal::PowerSupplyAmperage),
            ReadCtable(),
            ReadLocalGravity(),
            ReadConfigRegister(),
            ReadHVPSWarmUp(),
            ReadGammaRayAcqusitionTime(),
            ReadVoltage(),
            ReadCalibrateHVPS(),
            ReadMasterStatusRegister(),};
}

//---------------------------------------
void NodeE4::set_gui(SRIG_GUI *gui)
{
    m_gui = gui;
}

//---------------------------------------
const std::list<Adam::Frame> &NodeE4::requests() const
{
    return m_requests;
}

//---------------------------------------
Adam::Frame NodeE4::ReadGammaRayData(byte buckets)
{
    if (buckets < 1) buckets = 1;
    if (buckets > 32) buckets = 32;
    return Adam::Frame(NodeE4::Code, 0xff, 0x01, buckets);
}

//---------------------------------------
Adam::Frame NodeE4::ReadTemperature()
{
    return Adam::Frame(NodeE4::Code, 0xff, 0x05, 1);
}

//---------------------------------------
Adam::Frame NodeE4::ReadAccelerometerRawData(AvgType avgType)
{
    return Adam::Frame(NodeE4::Code, 0xff, 0x06, (uint8_t)avgType);
}

//---------------------------------------
Adam::Frame NodeE4::ReadAccelerometerInclinationData(AvgType avgType)
{
    return Adam::Frame(NodeE4::Code, 0xff, 0x11, (uint8_t)avgType);
}

//---------------------------------------
Adam::Frame NodeE4::ReadAdcSignal(AdcSignal signal)
{
    return Adam::Frame(NodeE4::Code, 0xff, 0x1E, (uint8_t)signal);
}

//---------------------------------------
Adam::Frame NodeE4::ReadAccelerometerCorrectedData(AvgType avgType)
{
    return Adam::Frame(NodeE4::Code, 0xff, 0x18, (uint8_t)avgType);
}

//---------------------------------------
Adam::Frame NodeE4::ReadPartNumber()
{
    return Adam::Frame(NodeE4::Code, 0xff, 0xfc);
}

Adam::Frame NodeE4::ReadCtable()
{
    return Adam::Frame(NodeE4::Code, 0xff, 0x50);
}

Adam::Frame NodeE4::WriteCtable(Ctable ctable)
{
    //// return Adam::Frame(NodeE4::Code, 0xff, 0x50,
    /// StructConverter.StructToBytes(ctable));
    return Adam::Frame(NodeE4::Code, 0xff, 0x50, ctable.serialize());
}

Adam::Frame NodeE4::ReadLocalGravity()
{
    return Adam::Frame(NodeE4::Code, 0xff, 0x51);
}

Adam::Frame NodeE4::WriteLocalGravity(float value)
{
    return Adam::Frame(NodeE4::Code, 0xff, 0x51, Adam::decode_ieee754(value));
}

Adam::Frame NodeE4::ReadConfigRegister()
{
    return Adam::Frame(NodeE4::Code, 0xff, 0x1f);
}

Adam::Frame NodeE4::WriteConfigRegister(float value)
{
    return Adam::Frame(NodeE4::Code, 0xff, 0x1f, Adam::decode_ieee754(value));
}

Adam::Frame NodeE4::ReadHVPSWarmUp()
{
    return Adam::Frame(NodeE4::Code, 0xff, 0x46);
}

Adam::Frame NodeE4::WriteHVPSWarmUp(float value)
{
    return Adam::Frame(NodeE4::Code, 0xff, 0x46, Adam::decode_ieee754(value));
}

Adam::Frame NodeE4::ReadGammaRayAcqusitionTime()
{
    return Adam::Frame(NodeE4::Code, 0xff, 0x13);
}

Adam::Frame NodeE4::WriteGammaRayAcqusitionTime(float value)
{
    return Adam::Frame(NodeE4::Code, 0xff, 0x13, Adam::decode_ieee754(value));
}

Adam::Frame NodeE4::ReadVoltage()
{
    return Adam::Frame(NodeE4::Code, 0xff, 0x43);
}

Adam::Frame NodeE4::WriteVoltage(float value)
{
    return Adam::Frame(NodeE4::Code, 0xff, 0x43, Adam::decode_ieee754(value));
}

Adam::Frame NodeE4::ReadCalibrateHVPS()
{
    return Adam::Frame(NodeE4::Code, 0xff, 0x42);
}

Adam::Frame NodeE4::WriteCalibrateHVPS(float value)
{
    return Adam::Frame(NodeE4::Code, 0xff, 0x42, Adam::decode_ieee754(value));
}

Adam::Frame NodeE4::ReadHVPSCorr()
{
    return Adam::Frame(NodeE4::Code, 0xff, 0x44);
}

Adam::Frame NodeE4::WriteHVPSCorr(float value)
{
    return Adam::Frame(NodeE4::Code, 0xff, 0x44, Adam::decode_ieee754(value));
}

Adam::Frame NodeE4::ReadMasterStatusRegister()
{
    return Adam::Frame(NodeE4::Code, 0xff, 0xf1);
}

Adam::Frame NodeE4::WriteMasterStatusRegister(float value)
{
    return Adam::Frame(NodeE4::Code, 0xff, 0xf1, Adam::decode_ieee754(value));
}

Adam::Frame NodeE4::WriteAccelerometerPowerOn()
{
    return Adam::Frame(NodeE4::Code, 0xff, 0x20, 0x01);
}

Adam::Frame NodeE4::WriteAccelerometerPowerOff()
{
    return Adam::Frame(NodeE4::Code, 0xff, 0x20, 0x00);
}

Adam::Frame NodeE4::WriteStartADCCalibration()
{
    return Adam::Frame(NodeE4::Code, 0xff, 0x20, 0x10);
}

// ;Accelerometer power supply 00000   000    Turn off                    <0x00>
// ;                                   001    Turn on                     <0x01>
// ;Serial Communication       00001   000    Enable DV485/Disable LT1039 <0x08>
// ;                                   001    Enable LT1039/Disable DV485 <0x09>
// ;ADC7701                    00010   000    Start calibration           <0x10>


bool NodeE4::check_ack(const Adam::Response& response)
{
    QString cmdHex      = QString("[%1]").arg(response.cmd(), 2, 16, QChar('0'));
    //// QString elapsedTime = QString("%1 %2").arg(response.elapsed_time()).arg(tr("ms"));

    QString cAck = QString("0x%1").arg(response.ack(), 2, 16, QChar('0')).toUpper();
    //// TODO m_fld_platoAck->setText(cAck);
    //// TODO m_setup_ACK_code->setText(cAck);

    QString cStatus = QString("0x%1").arg(response.status(), 4, 16, QChar('0')).toUpper();
    //// TODO m_fld_platoStatus->setText(cStatus);
    //// TODO m_setup_status->setText(cStatus);

    if (response.ack() == 0)
    {
        //// TODO m_fld_platoAck_msg->setText(tr("Success"));
        //// TODO m_setup_ACK_text->setText(tr("Success"));
        return true;
    }

    if (response.ack() == 0xFB || response.ack() == 0xFD)
    {
        QString bf = QString("%1 %2").arg(cmdHex).arg(tr("wrong request"));
        //// TODO m_setup_ACK_text->setText(bf);
        //// TODO m_fld_platoAck_msg->setText(bf);

        bf = QString("%1 %2 %3 - %4").arg(cmdHex, tr("ERROR"), cAck, tr("wrong request"));
        //// TODO m_fld_platoAck->setToolTip(bf);
        //// TODO m_fld_platoAck_msg->setToolTip(bf);

        //// TODO m_setup_ACK_text->setToolTip(bf);
        //// TODO m_setup_ACK_code->setToolTip(bf);

        m_gui->showstatus(bf);
        //// TODO m_terminal->put_data_ln(bf.toUtf8());
        return false;
    }

    QString buf2;
    QString buf = QString("%1 %2").arg(cmdHex).arg(tr("ERROR"));
    if (response.cmd() == 0x40 ||
        response.cmd() == 0x41 ||
        response.cmd() == 0x42 ||
        response.cmd() == 0x20)
    {
        buf = QString("%1 %2 0x%3").arg(cmdHex, tr("Ack"), response.ack(), 2, 16, QChar('0'));
    }

    if (response.cmd() == 0x20)
    {
        if (response.ask() == 0x03)
        {
            buf  = tr("The serial communication requires reset");
            buf2 = tr("The serial communication control will only be effective after reset");
        }
    }
    else if (response.cmd() == 0x40 ||
             response.cmd() == 0x41 ||
             response.cmd() == 0x42)
    {
        if (tool->m_request->m_ack == 0x01)
            buf = tr("The HVPS turns on for ten seconds");
    }

    if (buf2.isEmpty()) buf2 = buf;
    // TODO m_fld_platoAck_msg->setText(buf);
    // TODO m_fld_platoAck_msg->setToolTip(buf2);
    // TODO m_fld_platoAck->setToolTip(buf2);

    // TODO m_setup_ACK_text->setText(buf);
    // TODO m_setup_ACK_text->setToolTip(buf2);
    // TODO m_setup_ACK_code->setToolTip(buf2);

    // TODO m_terminal->put_data_ln(buf.toUtf8());
    m_gui->showstatus(buf);
    return false;
}

//---------------------------------------------------------
void NodeE4::parse_response(const Adam::Response &response)
{
    //// QString error_string;
    //// QString cmd_hex      = QString("[%1]").arg(response.cmd(), 2, 16, QChar('0'));
    //// QString cElapsedTime = QString("%1 %2").arg(response.elapsed_time()).arg(tr("ms"));

    set_status(response.status());
    qDebug("%s response - cmd:%02x, status:0x%04X, size:%-6d, %dms",
           name().c_str(), response.cmd(), response.status(), response.payload_size(), response.elapsed_time());

    if (!check_ack(tool))
    {
        //// TODO if (m_tools->get_mode() == TOOLS::MODE_PLATO)
        //// TODO {
        //// TODO     if (m_button_plato_run->isChecked())
        //// TODO     {
        //// TODO         m_button_plato_run->setChecked(false); // остановить тест
        //// TODO         set_button_status(m_button_plato_run);
        //// TODO         platotest__control();
        //// TODO     }
        //// TODO }
        return;
    }

    byte cmd = response.cmd();
    switch (cmd)
    {
        case 0x01: // Read Gamma Ray Data
        {
            response_0x01(response);
            // [01] Read Gamma Ray Data
            // [RTIME]=200
            // [CTYPE]=2
            // ;
            // B CMDEXT,N/A;Command Extention
            // F Gamma,cps;Gamma Ray counts per second
            //
            // ;This command tells the node to transmit gamma ray data.  This data is the average of "n" buckets
            // ;(acquisitions).  The gamma ray returned is IEEE floating point counts per second.  Bucket
            // ;limits are 1 (0x01) to 32 (0x20).  If the bucket count requested is outside the limits, the
            // ;node returns an <0xFD> cmd ack with no data.  If more buckets are requested than what is
            // ;available, the bucket count in the response indicates the number of buckets that were averaged.
            //
            // ;Tx = <msg header> <0x01> <cmd ext> <chksum>
            // ;<cmd ext> ::= <0x01>...<0x20>
            //
            // ;Rx = <msg header> <0x01> <cmd ack> <slave status> <cmd ext> <gamma ray> <chksum>
            // ;<cmd ack> 	::= <0x00> | <0xFD>
            // ;<cmd ext> 	::= <0x01>...<0x20>
            // ;<gamma ray>	::= <IEEE FP>

            if (response.payload_size() > 4)
            {
                const auto& data = response.payload();
                qint8 ext = data.at(0);
                if( ext >= 1 && ext <= 32 )
                {
                    m_gamma_buckets = data.at(0);
                    m_gamma_value   = Adam::decode_ieee754(data.data()+1, data.size()-1);

                    if (m_gamma_accumulation)
                    {
                        m_gamma_sum += m_gamma_value;
                        ++m_gamma_counter;
                        qDebug() << m_gamma_value << " total:" << m_gamma_sum << "cnts:" << m_gamma_counter;
                    }

                    //// TODO auto txt = QString("[%1] %2").arg( m_gamma_buckets ).arg( m_gamma_value, 0, 'f', 2 );
                    //// TODO m_flddiag_gammaCnts->setText( txt );
                    //// TODO m_fld_platoCnts->setText( QString::number( m_gamma_value, 'f', 2 ) );
                    //// TODO m_setup_GammaCnts->setText( QString::number( m_gamma_value, 'f', 2 ) );
                    //// TODO QByteArray ba( "Cnts: " );
                    //// TODO ba += txt.toUtf8() + QByteArrayLiteral("\n");
                    //// TODO m_terminal->put_data( ba );
                    //// TODO if( m_flddiag_gammaCnts_log->isChecked() )
                    //// TODO {
                    //// TODO     write_term_protocol_record( QString::number( m_gamma_buckets ), -12 );
                    //// TODO     write_term_protocol_record( QString::number( m_gamma_value, 'f', 2 ), -12 );
                    //// TODO }
                    qDebug() << "    gamma:" << m_gamma_buckets << m_gamma_value
                             << "total:" << m_gamma_sum << "cnts:" << m_gamma_counter;
                }
            }
            else
            {
                qDebug() << "INCORRECT RESPONSE - expected data size at least 5 but got "
                         << response.payload_size() ;
            }
            break;
        }

        case 0x05: // Read Temperature Data
        {
            // [05] Read Temperature Data
            // [RTIME]=200
            // [CTYPE]=2
            // ;
            // B CMDEXT,N/A;Command Extention
            // F Temp,deg C;temperature of the SRIG
            // ;
            // ;This command tells the node to transmit the internal temperature of the SRIG based on "n"
            // ;buckets of acquisitions (averaged).  One acquisition is the average of four analogs to digital
            // ;conversions.  The temperature returned is IEEE floating point degrees Celsius.  Bucket limit
            // ;is 1.  If the bucket count is outside the limit, the node returns an <0xFD> cmd ack with no data.
            // ;
            // ;Tx = <msg header> <0x05> <cmd ext> <chksum>
            // ;<cmd ext> ::= <0x01>
            // ;
            // ;Rx = <msg header> <0x05> <cmd ack> <slave status> <cmd ext> <temperature> <chksum>
            // ;<cmd ack> ::= <0x00> | <0xFB> | <0xFD>
            // ;<cmd ext> ::= <0x01>
            // ;<temperature> ::= <IEEE FP>
            // "fce4 000f 05 00 0000 01 41f2fc90 04b4"

            //// TODO m_flddiag_Temperature_cmd->setText( stuff_cmdhex );
            //// TODO m_flddiag_Temperature_ms->setText(  stuff_elapsed_time );
            if (response.payload_size() > 4)
            {
                const auto& data = response.payload();
                m_temperature_buckets = data.at(0);
                m_temperature_value = Adam::decode_ieee754(data.data()+1, data.size()-1);

                //// TODO QString bf = QString( "[%1] %2" )
                //// TODO              .arg(QString::number(data.at(0),16))
                //// TODO              .arg(QString::number(m_temperature_value, 'f', 2);
                //// TODO m_flddiag_Temperature->setText(bf);
                //// TODO m_fld_platoTemp->setText(QString::number(m_temperature_value, 'f', 1));
                //// TODO m_setup_Temp->setText(QString::number(m_temperature_value, 'f', 4));

                //// TODO if( m_plato_hot_mode == 0 )
                //// TODO {
                //// TODO     if( m_temperature_value > m_plato_hot_mode_temp )
                //// TODO     {
                //// TODO         QString msg = QString("%1%2C > %3%4C - %5")
                //// TODO                       .arg( m_temperature_value, 0, 'f', 1 )
                //// TODO                       .arg( QChar(Qt::Key_degree) )
                //// TODO                       .arg( m_plato_hot_mode_temp )
                //// TODO                       .arg( QChar(Qt::Key_degree) )
                //// TODO                       .arg( "WRONG TEMPERATURE MODE" );
                //// TODO         showstatus( msg );
                //// TODO     }
                //// TODO }
                //// TODO else
                //// TODO {
                //// TODO     if( m_temperature_value < m_plato_hot_mode_temp )
                //// TODO     {
                //// TODO         QString msg = QString("%1%2C < %3%4C - %5")
                //// TODO                       .arg( m_temperature_value, 0, 'f', 1 )
                //// TODO                       .arg( QChar(Qt::Key_degree) )
                //// TODO                       .arg( m_plato_hot_mode_temp )
                //// TODO                       .arg( QChar(Qt::Key_degree) )
                //// TODO                       .arg( "WRONG TEMPERATURE MODE" );
                //// TODO         showstatus( msg );
                //// TODO     }
                //// TODO }
                //// TODO m_terminal->put_data_ln( "Temp: "+ QByteArray::number(temp,'f',2) );
                //// TODO if( m_flddiag_Temperature_log->isChecked() )
                //// TODO     write_term_protocol_record( QByteArray::number( temp, 'f', 2), -12 );
                qDebug() << "    temp" << m_temperature_buckets << m_temperature_value;
                //// TODO m_gui->update_cv_temp(m_temperature_data.Temp);
            }
            else
            {
                qDebug() << "INCORRECT RESPONSE - expected data size at least 5 but got "
                         << response.payload_size() ;
            }
            break;
        }

        case 0x06: // Read  Accelerometer Raw Data
        {
            // B Avg Type,N/A; 01=Short, 02=Medium, 03=Long
            // F VGz,volts;Raw voltage from the 16 bit ADC that is attached to the Z axis accelerometer
            // ;
            // ;This command request for the raw voltage data from the 16 bit ADC
            // ;that is attached to the Z-axis accelerometer.
            // ;Tx = <msg header> <0x06> <cmd ext> <chksum>
            // ;<cmd ext> ::= <0x01> | <0x02> | <0x03>
            // ;
            // ;Rx = <msg header> <0x06> <cmd ack> <slave status> <cmd ext> <VGz> <chksum>
            // ;<cmd ack>  ::= <0x00> | <0xFB> | <0xFD>
            // ;<cmd ext>  ::= <0x01> | <0x02> | <0x03>
            // ;<VGz> ::= <IEEE FP>

            //// TODO m_flddiag_Gz_cmd->setText( stuff_cmdhex );
            //// TODO m_flddiag_Gz_ms ->setText( stuff_elapsed_time );

            if (response.payload_size() > 4)
            {
                const auto& data = response.payload();
                auto ext = static_cast<AvgType>(data.at(0));
                if (ext >= 1 && ext <= 3)
                {
                    int i = ext-1;
                    float value = Adam::decode_ieee754(data.data()+1, data.size()-1);
                    m_accelerometer_raw_value[i] = value;
                    //// TODO txt = QString("%1  %2  %3")
                    //// TODO         .arg(m_accelerometer_raw_value[0], 0, 'f', 6)
                    //// TODO         .arg(m_accelerometer_raw_value[1], 0, 'f', 6)
                    //// TODO         .arg(m_accelerometer_raw_value[2], 0, 'f', 6);
                    //// TODO m_flddiag_Gz->setText( txt );
                    //// TODO m_flddiag_Gz->setToolTip( txt );
                    //// TODO m_setup_Gz_Raw->setText( QString::number( m_accelerometer_raw_value[2], 'f', 6 ) );
                    //// TODO QByteArray ba( "Acc Raw:" );
                    //// TODO ba += txt.toUtf8() + QByteArrayLiteral("\n");
                    //// TODO m_terminal->put_data( ba );
                    //// TODO if( m_flddiag_Gz_log->isChecked() )
                    //// TODO     write_term_protocol_record( QString::number( m_accelerometer_raw_value[i], 'f', 1 ), -12 );
                    qDebug() << "    accelerometer raw:" << (int)ext << value;
                    //// TODO m_gui->update_setup_raw_gz(value);
                }
            }
            else
            {
                qDebug() << "INCORRECT RESPONSE - expected data size at least 5 but got "
                         << response.payload_size() ;
            }
            break;
        }

        case 0x11: // Read Accelerometer Inclination Data
        {
            // B CmdExt,N/A;Command Extention
            // F Inc,deg;Inclination
            // ;
            // ;This command request to read the inclination from the MCU.
            // ;The command extension is the size of the bucket.
            // ;
            // ;Tx = <msg header> <0x11> <cmd ext> <chksum>
            // ;<cmd ext> ::= <0x01> | <0x02> | <0x03>
            // ;
            // ;Rx = <msg header> <0x11> <cmd ack> <slave status> <cmd ext> <Inclination> <chksum>
            // ;<cmd ack>	 ::= <0x00> | <0xFB> | <0xFD>
            // ;<cmd ext>	 ::= <0x01> | <0x02> | <0x03>
            // ;<Inclination>	::= <IEEE FP>

            //// TODO m_flddiag_GzIncl_cmd->setText( stuff_cmdhex );
            //// TODO m_flddiag_GzIncl_ms ->setText( stuff_elapsed_time );
            if (response.payload_size() > 4)
            {
                const auto& data = response.payload();
                auto ext = static_cast<AvgType>(data.at(0));
                if (ext >= 1 && ext <= 3)
                {
                    auto value = Adam::decode_ieee754(data.data() + 1, data.size() - 1);
                    int i = ext-1;
                    m_accelerometer_inclination_value[i] = value;
                    //// TODO txt = QString("%1  %2  %3")
                    //// TODO         .arg(m_accelerometer_inclination_value[0], 0, 'f', 6 )
                    //// TODO         .arg(m_accelerometer_inclination_value[1], 0, 'f', 6 )
                    //// TODO         .arg(m_accelerometer_inclination_value[2], 0, 'f', 6 );
                    //// TODO m_flddiag_GzIncl->setText( txt );
                    //// TODO m_flddiag_GzIncl->setToolTip( txt );
                    //// TODO m_setup_Gz_Incl->setText( QString::number(m_accelerometer_inclination_value[AvgType::Medium], 'f', 6 ));
                    //// TODO QByteArray ba( "Acc Incl:" );
                    //// TODO ba += txt.toUtf8() + QByteArrayLiteral("\n");
                    //// TODO m_terminal->put_data( ba );
                    //// TODO if( m_flddiag_GzIncl_log->isChecked() )
                    //// TODO     write_term_protocol_record( QString::number(m_accelerometer_inclination_value[i], 'f', 1 ), -12);
                    qDebug() << "    accelerometer incl: " << (int)ext << value;
                    //// m_gui->update_setup_incl(value);
                }
            }
            else
            {
                qDebug() << "INCORRECT RESPONSE - expected data size at least 5 but got "
                         << response.payload_size() ;
            }
            break;
        }

        case 0x13:  // Read/Write Gamma Ray Acquisition Time
        {
            // [RTIME]=200
            // [CTYPE]=3
            // ;
            // W Acq time,10th sec;Acquisition Time
            // ;
            // ;The gamma acquisition time is the period used to acquire one gamma sample.  A 'bucket' refers
            // ;to one of these acquisitions.  The units used are tenths of a second and the limits are
            // ;10 to 600 (1s to 60s).
            // ;
            // ;Read Gamma Ray Acquisition Time
            // ;This command instructs the node to return the gamma acquisition time.  Gamma Acquisition time
            // ;reads from and writes to non-volatile memory.
            // ;
            // ;Tx = <msg header> <0x13> <chksum>
            // ;
            // ;Rx = <msg header> <0x13> <cmd ack> <slave status> <acq time> <chksum>
            // ;<cmd ack> ::= <0x00>
            // ;<acq time> ::= <MSByte> <LSByte>
            // ;
            // ; Write Gamma Ray Acquisition Time
            // ;This command instructs the node to change the gamma acquisition time.  The acquisition time
            // ;changes immediately but this does not affect any sample in progress.  If acq time is outside
            // ;the limit, the node returns an <0xFD> cmd ack and sets it to the limit.
            // ;
            // ;Tx = <msg header> <0x13> <acq time> <chksum>
            // ;<acq time> ::= <MSByte> <LSByte>
            // ;
            // ;Rx = <msg header> <0x13> <cmd ack> <slave status> <chksum>
            // ;<cmd ack> ::= <0x00> | <0xFD>

            //// TODO m_flddiag_gammaAcqTime_cmd->setText(cCmdHex);
            //// TODO m_flddiag_gammaAcqTime_ms ->setText(cElapsedTime);

            if (response.payload_size() > 1)
            {
                const auto& data = response.payload();
                ushort num = (data.at(0) << 8) | data.at(1);
                m_acqtime = num*0.1;

                //// TODO txt = QString("%1 (%2 %3)").arg(num).arg(m_acqtime, 0, 'f', 1).arg(tr("sec"));
                //// TODO m_flddiag_gammaAcqTime->setText(txt);
                //// TODO m_setup_acqtime->setText(QString::number(num));
                //// TODO m_setup_acqtime->setToolTip(txt);

                //// TODO m_acquire_time = (m_acq_time + m_acq_warmup) * 2;
                //// TODO QString bf = QString("(%1+%2)*2=%3%4")
                //// TODO              .arg(m_acq_time, 0, 'f', 1)
                //// TODO              .arg(m_acq_warmup, 0, 'f', 1)
                //// TODO              .arg(m_acquire_time)
                //// TODO              .arg(tr("sec"));
                //// TODO m_fld_acq_time->setText(bf);

                //// TODO QByteArray ba("AcqTime: ");
                //// TODO ba += txt.toUtf8() + QByteArrayLiteral("\n");
                //// TODO m_terminal->put_data(ba);

                //// TODO if (m_flddiag_gammaAcqTime_log->isChecked())
                //// TODO     write_term_protocol_record(QString("%1").arg(m_acq_time, 0, 'f', 1), -12);
                qDebug("    acquisition time: '%d' (%d sec)", num, m_acqtime);
                //// m_gui->update_setup_acqtime(m_setup_acqtime);
            }
            else
            {
                qDebug() << "INCORRECT RESPONSE - expected data size at least 1 but got "
                         << response.payload_size();
            }
            break;
        }

        case 0x18: // Read Accelerometer corrected data
        {
            // B CmdExt,N/A;Command Extention
            // F Gz,g's;accelerometer Z axis data which is corrected for bias, scale factor, and
            // ;	temperature
            // ;
            // ;This command request for the accelerometer Z-axis data which is being corrected for bias,
            // ;scale factor, and temperature, using 3rd-order models.
            // ;
            // ;Tx = <msg header> <0x18> <cmd ext> <chksum>
            // ;<cmd ext> ::= <0x01> | <0x02> | <0x03>
            // ;
            // ;Rx = <msg header> <0x08> <cmd ack> <slave status> <cmd ext> <Gz> <chksum>
            // ;<cmd ack	 ::= <0x00> | <0xFB> | <0xFD>
            // ;<cmd ext>	 ::= <0x01> | <0x02> | <0x03>
            // ;<Gz> 		::= <IEEE FP>

            //// m_flddiag_GzCorr_cmd->setText( stuff_cmdhex );
            //// m_flddiag_GzCorr_ms ->setText( stuff_elapsed_time );
            if (response.payload_size() > 4)
            {
                const auto& data = response.payload();
                auto ext = static_cast<AvgType>(data.at(0));
                if (ext >= 1 && ext <= 3)
                {
                    //// m_gui->update_cv_gz(m_accelerometer_corrected_data.Gz);

                    int i = ext-1;
                    auto value = Adam::decode_ieee754(data.data()+1, data.size()-1);
                    m_accelerometer_corrected_value[i] = value;
                    //// TODO txt = QStringLiteral("%1  %2  %3")
                    //// TODO         .arg(m_accelerometer_corrected_value[0], 0, 'f', 6 )
                    //// TODO         .arg(m_accelerometer_corrected_value[1], 0, 'f', 6 )
                    //// TODO         .arg(m_accelerometer_corrected_value[2], 0, 'f', 6 );
                    //// TODO m_flddiag_GzCorr->setText( txt );
                    //// TODO m_flddiag_GzCorr->setToolTip( txt );
                    //// TODO m_setup_Gz_Corr->setText( QString::number(m_accelerometer_corrected_value[AvgType::Medium], 'f', 6 ) );
                    //// TODO QByteArray ba( "Acc corr:" );
                    //// TODO ba += txt.toUtf8() + QByteArrayLiteral("\n");
                    //// TODO m_terminal->put_data( ba );
                    //// TODO if( m_flddiag_GzCorr_log->isChecked() )
                    //// TODO     write_term_protocol_record( QString::number( m_Gz_corrected[i], 'f', 1 ), -12 );
                    qDebug() << "    accelerometer corrected:" << (int)ext, value;
                    //// m_gui->update_setup_xxx(value);
                }
            }
            else
            {
                qDebug() << "INCORRECT RESPONSE - expected data size at least 5 but got "
                         << response.payload_size() ;
            }
            break;
        }

        case 0x20: // Device Control
        {
            // [20] Device Control
            // [RTIME]=200
            // [CTYPE]=2
            // ;
            // B Hex,Hex;Hex Byte
            // F ADC,N/A;ADC Reading
            // ;
            // ;This command allows the control of the SRIG built-in devices. This command is written to aid
            // ;the testing of the hardware.
            // ;
            // ;Tx = <msg header> <0x20> <cmd ext> <chksum>
            // ;<cmd ext> ::= <hex byte>
            // ;The one byte command extension can be divided into two parts: the device number and the
            // ;function number. The device number is a 5-bit number which is from bit3 to bit7 of the command
            // ;extension, and the function number is a 3-bit number which is from bit0 to bit2. The SRIG board
            // ;therefore can have up to 32 devices, and each device can have up to 8 control functions.
            // ;
            // ;The current implemented SRIG device control is stated as follows.
            // ;
            // ;Device name                Device# Func#  Description                 cmd ext
            // ;_____________________________________________________________________________________
            // ;Accelerometer power supply 00000   000    Turn off                    <0x00>
            // ;                                   001    Turn on                     <0x01>
            // ;Serial Communication       00001   000    Enable DV485/Disable LT1039 <0x08>
            // ;                                   001    Enable LT1039/Disable DV485 <0x09>
            // ;ADC7701                    00010   000    Start calibration           <0x10>
            // ;
            // ;When turn on the accelerometer power supply, the firmware will also wake up the ADC7701 and
            // ;start the accelerometer acquisition timer. When turn off the accelerometer power, the firmware
            // ;will put the ADC7701 into sleep mode and stop the acquisition timer.  While both of the
            // ;accelerometer power supply and ADC7701 control is effective immediately,the serial communication
            // ;control will only be effective after reset, thus the return cmd ack will be 0x03.
            // ;
            // ;Rx = <msg header> <0x20> <cmd ack> <slave status> <cmd ext> <ADC reading> <chksum>
            // ;<cmd ack> ::= <0x00> | <0x03> | <0xFD>
            // ;<cmd ext> ::= <hex byte>
            // ;<ADC reading>::= <IEEE FP>

            if (response.payload_size() > 3)
            {
                const auto& data = response.payload();
                byte ext = data.at(0);
                auto value = Adam::decode_ieee754(data.data()+1, data.size()-1);
                //// TODO txt = QString::number( value, 'f', 6 );
                //// TODO //m_setup_grav_field->setText( txt );
                //// TODO m_terminal->put_data_ln( QByteArrayLiteral("ADC: ") + txt.toLocal8Bit() );

                //// TODO //if( m_flddiag_gravity_log->isChecked() )
                //// TODO //    write_term_protocol_record( txt.toLocal8Bit(), -12 );
                qDebug("    Device Control: %d - %f", ext, value);
                //// m_gui->update_setup_xxx(value);
            }
            else
            {
                qDebug() << "INCORRECT RESPONSE - expected data size at least 4 but got "
                         << response.payload_size();
            }
            break;
        }

        case 0x40: // Set HVPS Low
        {
            // [40] Set HVPS Low
            // [RTIME]=200
            // [CTYPE]=0
            // ;
            // ;Use this command to learn the lowest possible voltage of the HVPS.  You will need this
            // ;information to calibrate the HVPS.  This command sets the DAC to 0x00, the node returns a
            // ;<0x01> cmd ack and the HVPS turns on for ten seconds.  Record this voltage for future use.
            // ;
            // ;Tx = <msg header> <0x40> <chksum>
            // ;
            // ;Rx = <msg header> <0x40> <cmd ack> <slave status> <chksum>
            // ;<cmd ack> ::= <0x01> | <0x04>
            qDebug("    HVPS Low ack: '0x%02x'", response.ack());
            break;
        }

        case 0x41: // Set HVPS High
        {
            // [41] Set HVPS High
            // [RTIME]=200
            // [CTYPE]=0
            // ;
            // ;Use this command to learn the highest  possible voltage of the HVPS.  You will need this
            // ;information to calibrate the HVPS.  This command sets the DAC to 0xFF, the node returns a
            // ;<0x01> cmd ack and the HVPS turns on for ten seconds.  Record this voltage for future use.
            // ;
            // ;Tx = <msg header> <0x41> <chksum>
            // ;
            // ;Rx = <msg header> <0x41> <cmd ack> <slave status> <chksum>
            // ;<cmd ack> ::= <0x01> | <0x04>
            qDebug("    HVPS High ack: '0x%02x'", response.ack());
            break;
        }

        case 0x42: //  Read/Write Calibrate HVPS
        {
            // [42] Read/Write Calibrate HVPS
            // [RTIME]=200
            // [CTYPE]=3
            // ;
            // W Low,volts;Low Volt
            // W High,volts;High Volt
            // W Test,volts;Test Volt
            // ;
            // ;Use the recorded high and low voltages to calibrate the HVPS.  The tool uses these parameters
            // ;to calculate a scale factor and an offset.  LowVolt, HighVolt and TestVolt read from and write
            // ;to non-volatile memory.
            // ;
            // ;Read Calibrate HVPS
            // ;This command will read the HighVolt/LowVolt/TestVolt parameters.
            // ;
            // ;Tx = <msg header> <0x42> <chksum>
            // ;
            // ;Rx = <msg header> <0x42> <cmd ack> <slave status> <LowVolt> <HighVolt> <TestVolt> <chksum>
            // ;<cmd ack>	::= <0x00>
            // ;<LowVolt>	::= <MSByte> <LSByte>
            // ;<HighVolt>	::= <MSByte> <LSByte>
            // ;<TestVolt>	::= <MSByte> <LSByte>
            // ;
            // ;Write Calibrate HVPS
            // ;When you invoke this command with the hexadecimal voltage parameters, the tool will store the
            // ;voltages in non-volatile memory.  It will then calibrate the HVPS and set it to <TestVolt> for
            // ;ten seconds.  This is so the user can evaluate the accuracy of the newly calculated HVPS bias
            // ;and scale factor.
            // ;
            // ;Tx = <msg header> <0x42> <LowVolt> <HighVolt> <TestVolt> <chksum>
            // ;<LowVolt>	::= <MSByte> <LSByte>
            // ;<HighVolt>	::= <MSByte> <LSByte>
            // ;<TestVolt>	::= <MSByte> <LSByte>
            // ;
            // ;Rx = <msg header> <0x42> <cmd ack> <slave status> <chksum>
            // ;<cmd ack> ::= <0x01> | <0x04>
            // ;
            // ;Note: If the slave node's gamma state is in the power management mode when command number 0x40,
            // ;0x41, or 0x42 is received, the firmware will shut off the power management and set the high
            // ;voltage accordingly for 10 seconds. If one needs to resume the power management, then he needs
            // ;to issue the related command (0xF1, 0xF8) to initiate the power management.

            //// TODO m_flddiag_HVPS_max_cmd->setText( stuff_cmdhex );
            //// TODO m_flddiag_HVPS_max_ms ->setText( stuff_elapsed_time );

            if (response.payload_size() > 5)
            {
                const auto& data = response.payload();
                ushort voltage_lo = (data.at(0) << 8) | data.at(1);
                ushort voltage_hi = (data.at(2) << 8) | data.at(3);
                ushort voltage_tt = (data.at(4) << 8) | data.at(5);

                //// TODO m_flddiag_HVPS_max_cmd->setText( stuff_cmdhex );
                //// TODO m_flddiag_HVPS_max_ms ->setText( stuff_elapsed_time );
                //// TODO txt = QString("%1 / %2 / %3").arg(voltage_lo).arg(voltage_hi).arg(voltage_tst);
                //// TODO m_flddiag_HVPS_max->setText(txt);
                //// TODO m_setup_hvps_min->setText(  QString::number(voltage_lo ));
                //// TODO m_setup_hvps_max->setText(  QString::number(voltage_hi ));
                //// TODO m_setup_hvps_test->setText( QString::number(voltage_tst));
                //// TODO if( voltage_lo > m_plato_start_HV )
                //// TODO {
                //// TODO     int multiple = 50;
                //// TODO     int num = multiple - (voltage_lo % multiple);
                //// TODO     if( num > 0 ) m_plato_start_HV = voltage_lo + num;
                //// TODO }
                //// TODO if( voltage_hi < m_plato_stop_HV )
                //// TODO {
                //// TODO     int multiple = 50;
                //// TODO     int num = multiple - (voltage_hi % multiple);
                //// TODO     if( num > 0 ) m_plato_stop_HV = voltage_hi + num;
                //// TODO }
                //// TODO m_plato_total_steps = (m_plato_stop_HV - m_plato_start_HV) / m_plato_HV_step + 1;
                //// TODO m_terminal->put_data_ln( "Calibrate HVPS: " + txt.toUtf8() );
                //// TODO if( m_flddiag_HVPS_max_log->isChecked() )
                //// TODO     write_term_protocol_record( txt, -18 );
                qDebug("    HVPS Low:%d High:%d, Test:%d", voltage_lo, voltage_hi, voltage_tt);
            }
            else
            {
                qDebug() << "INCORRECT RESPONSE - expected data size at least 5 but got "
                         << response.payload_size();
            }
            break;
        }

        case 0x43: // Read/Write Voltage
        {
            // [43] Read/Write Voltage
            // [RTIME]=200
            // [CTYPE]=3
            //
            // W voltage,volts;Operating voltage level for the HVPS
            //
            // ;This command sets the operating voltage level for the HVPS.  HVPS Voltage reads from and writes
            // ;to non-volatile memory.
            //
            // ;Read Voltage
            // ;This command reads the HVPS operating voltage.
            //
            // ;Tx = <msg header> <0x43> <chksum>
            // ;
            // ;Rx = <msg header> <0x43> <cmd ack> <slave status> <voltage> <chksum>
            // ;<cmd ack> ::= <0x00>
            // ;<voltage> ::= <MSByte> <LSByte>
            //
            // ;Write Voltage
            // ;This command sets a new voltage level for the HVPS.  The HVPS voltage level changes immediately.
            // ;If data acquisition is in progress, the current bucket should be suspect.  The units are Volts
            // ;and the limits are <LowVolt> and <HighVolt>.  (These voltage parameters were stored using the
            // ;Calibrate HVPS command.)  If Voltage is outside the limits, an <0xFD> cmd ack is returned and
            // ;it is set to the limit.
            //
            // ;Tx = <msg header> <0x43> <voltage> <chksum>
            // ;<voltage> ::= <MSByte> <LSByte>
            // ;
            // ;Rx = <msg header> <0x43> <cmd ack> <slave status> <chksum>
            // ;<cmd ack> ::= <0x00> | <0xFD>

            //// TODO m_flddiag_HVPS_cmd->setText( stuff_cmdhex );
            //// TODO m_flddiag_HVPS_ms ->setText( stuff_elapsed_time );
            if (response.payload_size() > 1)
            {
                const auto& data = response.payload();
                ushort voltage = (data.at(0) << 8) | data.at(1);

                //// TODO m_flddiag_HVPS_cmd->setText( stuff_cmdhex );
                //// TODO m_flddiag_HVPS_ms ->setText( stuff_elapsed_time );
                //// TODO txt = QString::number( voltage );
                //// TODO m_flddiag_HVPS->setText( txt );
                //// TODO m_fld_platoHVPS->setText( txt );
                //// TODO m_setup_hvps_oper->setText( txt );
                //// TODO txt = QString( "Voltage: %1" ).arg( voltage );
                //// TODO m_terminal->put_data_ln( txt.toUtf8() );
                //// TODO if( m_flddiag_HVPS_log->isChecked() )
                //// TODO     write_term_protocol_record( QString::number( voltage, 10 ), -12 );
                qDebug("    HVPS Voltage:%d", voltage);
                //// m_gui->update_setup_xxx(value);
            }
            else
            {
                qDebug() << "INCORRECT RESPONSE - expected data size at least 2 but got "
                         << response.payload_size();
            }
            break;
        }

        case 0x44: // Read HVPScorr
        {
            // [44] Read HVPScorr
            // [RTIME]=200
            // [CTYPE]=1
            // ;
            // B hvpscorr,N/A;HVPScorr is the hex value being written to the HVPS DAC to produce a specified
            // ;	voltage.
            // ;
            // ;Tx = <msg header> <0x44> <chksum>
            // ;
            // ;Rx = <msg header> <0x44> <cmd ack> <slave status> <hvpscorr> <chksum>
            // ;<cmd ack>	::= <0x00>
            // ;<hvpscorr>	::= <byte>
            // ;

            //// TODO m_flddiag_HVPS_corr_cmd->setText( stuff_cmdhex );
            //// TODO m_flddiag_HVPS_corr_ms ->setText( stuff_elapsed_time );
            if (response.payload_size() > 0)
            {
                byte num = response.payload_byte();
                //// TODO m_flddiag_HVPS_corr_cmd->setText( stuff_cmdhex );
                //// TODO m_flddiag_HVPS_corr_ms ->setText( stuff_elapsed_time );
                //// TODO txt = QString( "%1" ).arg( value, 2, 16, QChar('0') ).toUpper();
                //// TODO txt = QString( "0x%1 (%2)" ).arg( txt ).arg( value, 3, 10 );
                //// TODO m_flddiag_HVPS_corr->setText( txt );
                //// TODO m_terminal->put_data_ln( "HVPS corr: " + txt.toUtf8() );
                //// TODO if( m_flddiag_HVPS_corr_log->isChecked() )
                //// TODO     write_term_protocol_record( txt.toUtf8(), -12 );
                qDebug("    HVPS corr: 0x%02x", num);
                //// m_gui->update_setup_xxx(value);
            }
            else
            {
                qDebug() << "INCORRECT RESPONSE - expected data size at least 1 but got "
                         << response.payload_size();
            }
            break;
        }

        case 0x46: // Read/Write HVPS Warm-up
        {
            // [46] Read/Write HVPS Warm-up
            // [RTIME]=200
            // [CTYPE]=3
            // ;
            // B wm up,10ths sec;HVPS Warm-up is the delay between turning on the HVPS and starting an
            // ;	acquisition.  Units are tenths of a second and limits are 0.0s to 10.0s.  It is read from
            // ;	and written to non-volatile memory.
            // !!! замечание от программиста - значение считывается в секундах, а не в 10ths !!!
            // ;
            // ;Read HVPS Warm-up
            // ;
            // ;Tx = <msg header> <0x46> <chksum>
            // ;
            // ;Rx = <msg header> <0x46> <cmd ack> <slave status> <warm-up> <chksum>
            // ;<cmd ack>	::= <0x00>
            // ;<warm-up>	::= <hex byte>
            // ;
            // ;Write HVPS Warm-up
            // ;This command instructs the node to change the HVPS warm-up time.  If warm-up is outside the
            // ;limits, an <0xFD> cmd ack will be returned and it will be set to the appropriate limit.
            // ;
            // ;Tx = <msg header> <0x46> <warm-up> <chksum>
            // ;<warm-up> ::= <hex byte>
            // ;
            // ;Rx = <msg header> <0x46> <cmd ack> <slave status> <chksum>
            // ;<cmd ack> ::= <0x00> | <0xFD>

            //// TODO m_flddiag_HVPS_warm_cmd->setText( stuff_cmdhex );
            //// TODO m_flddiag_HVPS_warm_ms ->setText( stuff_elapsed_time );
            if (response.payload_size() > 0)
            {
                byte num = response.payload_byte();
                m_acq_warmup = num*0.1;
                qDebug("NodeE4 '%s', status:0x%04X, HVPS Warm-up: %d (%d sec)", name().c_str(), status(), num, m_acq_warmup);

                //// TODO m_flddiag_HVPS_warm_cmd->setText( stuff_cmdhex );
                //// TODO m_flddiag_HVPS_warm_ms ->setText( stuff_elapsed_time );
                //// TODO m_flddiag_HVPS_warm->setText( QString::number( m_acq_warmup, 'f', 1 ) );

                //// TODO txt = QString("%1%2 (%3 %4)").arg(tr( "Acq WarmUp:")).arg(num).arg( m_acq_warmup, 0, 'f', 1).arg( tr("sec"));
                //// TODO m_terminal->put_data_ln( txt.toUtf8() );
                //// TODO m_setup_warmuptime->setText( QString::number( num ) );
                //// TODO m_setup_warmuptime->setToolTip( txt );
                //// TODO if( m_flddiag_HVPS_warm_log->isChecked() )
                //// TODO     write_term_protocol_record( QString::number( m_acq_warmup, 'f', 1 ), -12 );
            }
            else
            {
                qDebug() << "INCORRECT RESPONSE - expected data size at least 1 but got "
                         << response.payload_size();
            }
            break;
        }

        case 0x50: // Read/Write CTABLE
        {
            // [50] Read/Write CTABLE
            // [RTIME]=200
            // [CTYPE]=3
            // X CS,N/A;Check Sum
            // A11 PN,N/A;Part Number
            // F Ksfz0,N/A;Scale Factor
            // F Ksfz1,N/A;Scale Factor
            // F Ksfz2,N/A;Scale Factor
            // F Ksfz3,N/A;Scale Factor
            // F Kbz0,N/A;Bias Constant
            // F Kbz1,N/A;Bias Constant
            // F Kbz2,N/A;Bias Constant
            // F Kbz3,N/A;Bias Constant
            // A7 Acc SN,N/A;Accelerometer Serial Number
            // A8 Date,N/A;Date
            // A5 Time,N/A;Time
            // A15 Res,N/A;Reserved
            // ;
            // ;The CTABLE is used to calibrate the Accelerometer and is a 80 bytes long table, therefore,
            // ;the CTABLE should be written into the EEPROM memory of the MCU prior to the operation in order
            // ;to get the correct inclination data. The format of the CTABLE is listed as follows
            // ;
            // ;Field name				Data type	Length	Default value
            // ;_____________________________________________________________________
            // ;Check sum				ushrt		2		*
            // ;Part number			char		11		77557TE100
            // ;Scale factor - Ksfz0	float		4		0.0
            // ;Scale factor - Ksfz1	float		4		1.0
            // ;Scale factor - Ksfz2	float		4		0.0
            // ;Scale factor - Ksfz3	float		4		0.0
            // ;Bias constant - Kbz0	float		4		0.0
            // ;Bias constant - Kbz1	float		4		1.0
            // ;Bias constant - Kbz2	float		4		0.0
            // ;Bias constant - Kbz3	float		4		0.0
            // ;Accelerometer S/N  	    char        7       *
            // ;Date					char		8		*
            // ;Time					char		5		*
            // ;Reserved				char		15		*
            // ;
            // ;Read CTABLE
            // ;This command instructs the node to return the CTABLE which is stored in the MCU's EEPROM memory.
            // ;Tx = <msg header> <0x50> <chksum>
            // ;Rx = <msg header> <0x50> <cmd ack> <slave status> <CTABLE> <chksum>
            // ;<cmd ack>	::= <0x00>
            // ;<CTABLE>	::= <Table of 80 bytes>
            // ;
            // ; Write CTABLE
            // ;This command instructs the node to change the contents of the CTABLE.
            // ;Tx = <msg header> <0x50> <CTABLE> <chksum>
            // ;<CTABLE> ::= <Table of 80 bytes>
            // ;Rx = <msg header> <0x50> <cmd ack> <slave status> <chksum>
            // ;<cmd ack> ::= <0x00> | <0xFD>

            if (response.payload_size() > 79)
            {
                m_ctable = response.payload();
                auto txt = QString( "Accel CTable - size:%1 CRC:%2 (0x%3) PN:%4\n"
                                    "%5 %6 %7 %8\n"
                                    "%9 %10 %11 %12\n"
                                    "SN:%13\nDate:%14 Time:%15" )
                           .arg(data.size())
                           .arg(m_ctable.m_check_sum)
                           .arg(m_ctable.m_check_sum, 4, 16, QChar('0'))
                           .arg(m_ctable.m_part_number)
                           .arg(m_ctable.m_scale_Ksfz0, 0, 'f', 8)
                           .arg(m_ctable.m_scale_Ksfz1, 0, 'f', 8)
                           .arg(m_ctable.m_scale_Ksfz2, 0, 'f', 8)
                           .arg(m_ctable.m_scale_Ksfz3, 0, 'f', 8)
                           .arg(m_ctable.m_bias_Kbz0,   0, 'f', 8)
                           .arg(m_ctable.m_bias_Kbz1,   0, 'f', 8)
                           .arg(m_ctable.m_bias_Kbz2,   0, 'f', 8)
                           .arg(m_ctable.m_bias_Kbz3,   0, 'f', 8)
                           .arg(m_ctable.m_accel_SN)
                           .arg(m_ctable.m_date)
                           .arg(m_ctable.m_time);
                //// TODO m_terminal->put_data_ln(txt.toUtf8());
                //if( m_flddiag_HVPS_warm_log->isChecked() )
                //    write_term_protocol_record( QString::number( m_acq_warmup, 'f', 1 ), -12 );
                m_gui->refresh_ctable();
                qDebug() << "    CTable:" << txt;
            }
            else
            {
                qDebug() << "INCORRECT RESPONSE - expected data size at least 80 but got "
                         << response.payload_size();
            }
            break;
        }

        case 0x51: // Read/Write Local Gravity
        {
            // [51] Read/Write Local Gravity
            // [RTIME]=200
            // [CTYPE]=3
            // ;
            // F local,N/A;local gravity, The local gravity is stored in the MCU's EEPROM memory which is used
            // ;to calculate the inclination. In most places, this number should be 1.00 where some other places
            // ;might have silghtly different from 1.00.  The local gravity should also be written into the
            // ;EEPROM when calibrate the SRIG in order to get the correct inclination data during operation.
            // ;
            // ;Read  Local Gravity
            // ;Tx = <msg header> <0x51> <chksum>
            // ;Rx = <msg header> <0x51> <cmd ack> <slave status> <local gravity> <chksum>
            // ;<cmd ack>  ::= <0x00>
            // ;<local gravity>    ::= <IEEE FP>
            // ;
            // ;Write Local Gravity
            // ;This command instructs the node to change the local gravity.
            // ;Tx = <msg header> <0x51> <local gravity> <chksum>
            // ;<local gravity> ::= <IEEE FP>
            // ;Rx = <msg header> <0x51> <cmd ack> <slave status> <chksum>
            // ;<cmd ack> ::= <0x00> | <0xFD>

            if (response.payload_size() > 3)
            {
                const auto& data = response.payload();
                auto value = (double)TOOLS::decode_ieee754(data);
                m_gravity = value;
                //// TODO txt = QString::number(value, 'f', 6);
                //// TODO m_setup_grav_field->setText( txt );
                //// TODO m_terminal->put_data_ln( QByteArrayLiteral("Local gravity field: ") + txt.toLocal8Bit() );
                //// TODO if( m_flddiag_gravity_log->isChecked() )
                //// TODO     write_term_protocol_record( txt.toLocal8Bit(), -12 );
                qDebug("    gravity: %f", value);
            }
            else
            {
                qDebug() << "INCORRECT RESPONSE - expected data size at least 4 but got "
                         << response.payload_size();
            }
            break;
        }

        case 0x1e: // Read the MCU's A/D converter
        {
            // ;Tx = <msg header> <0x1E> <cmd ext> <chksum>
            // ;<cmd ext> ::= <0x00>..<0x07>
            // ;
            // ;Each command extension related to one analog signal. The current SRIG board design for the
            // ;analog input and the relation to the command extension is shown as follows.
            // ;
            // ;<0x00>	: +15 VDC signal.
            // ;<0x01>	: +5 VDC signal.
            // ;<0x02>	: DV485 signal.
            // ;<0x03>	: High voltage control signal.
            // ;<0x04>	: Temperature sensor signal.
            // ;<0x05>	: Temperature circuit calibration signal.
            // ;<0x06>	: 2.5V reference signal.
            // ;<0x07>	: Power supply current.
            //
            // ;Rx = <msg header> <0x1E> <cmd ack> <slave status> <cmd ext> <ADC reading> <chksum>
            // ;<cmd ack> 	::= <0x00> | <0xFD>
            // ;<cmd ext> 	::= <0x00>..<0x07>
            // ;<ADC reading>	::= <IEEE FP>

            const auto& data = response.payload();
            auto ext = static_cast<AdcSignal>(data.at(0));
            if( ext >= 0 && ext <= 7 )
            {
                //// TODO m_flddiag_ADC_cmd[ext]->setText(cCmdHex);
                //// TODO m_flddiag_ADC_ms[ext] ->setText(cElapsedTime);
            }

            auto value = Adam::decode_ieee754(data.data()+1, data.size()-1);
            qDebug() << "nodeE4: analog" << (int)ext << "-" << value;

            //// TODO m_setup_ADC[ext]->setText(QString::number(value, 'f', 4));

            switch (ext)
            {
                case NodeE4::AdcSignal::Vdc15:
                    m_voltage15 = value;
                    //// m_gui->update_cv_analog_vdc15(voltage15);
                    //// m_gui->update_setup_analog_vdc15(voltage15);
                    break;

                case NodeE4::AdcSignal::Vdc5:
                    m_voltage5 = value;
                    //// m_gui->update_cv_analog_vdc5(voltage5);
                    //// m_gui->update_setup_analog_vdc5(voltage5);
                    break;

                case NodeE4::AdcSignal::Dv485:
                    m_dv485 = value;
                    //// m_gui->update_cv_analog_dv485(dv485);
                    //// m_gui->update_setup_analog_dv485(dv485);
                    break;

                case NodeE4::AdcSignal::HighVoltageControl:
                    m_high_voltage_control = value;
                    //// m_gui->update_cv_analog_high_voltage(high_voltage_control);
                    //// m_gui->update_setup_analog_high_voltage(high_voltage_control);
                    break;

                case NodeE4::AdcSignal::TempSensor:
                    m_temperature_sensor = value;
                    //// m_gui->update_cv_analog_temp_sensor_voltage(temperature_sensor);
                    //// m_gui->update_setup_analog_temp_sensor_voltage(temperature_sensor);
                    break;

                case NodeE4::AdcSignal::TempCircuitCalibration:
                    m_temperature_circuit_calibration = value;
                    //// m_gui->update_cv_analog_temperature_calibration_voltage(temperature_circuit_calibration);
                    //// m_gui->update_setup_analog_temperature_calibration_voltage(temperature_circuit_calibration);
                    break;

                case NodeE4::AdcSignal::Vdc25Reference:
                    m_vdc25_reference = value;
                    //// m_gui->update_cv_analog_ref_voltage(vdc25_reference);
                    //// m_gui->update_setup_analog_ref_voltage(vdc25_reference);

                case NodeE4::AdcSignal::PowerSupplyAmperage:
                    m_power_amperage = value;
                    //// m_gui->update_cv_analog_power_amperage(power_amperage);
                    //// m_gui->update_setup_analog_power_amperage(power_amperage);
            }
            break;
        }

        case 0x1f: // Read/Write CONFIG Register
        {
            //;Rx = <msg header> <0x1F> <cmd ack> <slave status> <config> <chksum>
            //;<cmd ack>  ::= <00>
            //;<config> ::= <byte>

            m_config_register = response.payload_byte();
            qDebug("NodeE4 '%s', status:0x%04X, config register: '0x%02x'", name().c_str(), status(), m_config_register);

            //// TODO m_flddiag_config_reg_cmd->setText( stuff_cmdhex );
            //// TODO m_flddiag_config_reg_ms->setText(  stuff_elapsed_time );
            //// TODO txt = QStringLiteral("%1").arg( num, 2, 16, QChar('0') ).toUpper();
            //// TODO m_flddiag_config_reg->setText( QStringLiteral("0x")+txt );
            //// TODO m_setup_cfgreg->setText( QStringLiteral("0x")+txt );

            //// TODO QByteArray ba( "CONFIG: " );
            //// TODO ba += txt.toUtf8() + QByteArrayLiteral("\n");
            //// TODO m_terminal->put_data( ba );
            //// TODO if( m_flddiag_config_log->isChecked() )
            //// TODO     write_term_protocol_record( txt, -12 );
            break;
        }

        case 0xf1: // Read/Write Master Status Register
        {
            // [F1] Read/Write Master Status Register
            // [RTIME]=200
            // [CTYPE]=3
            // ;
            // L MSR,N/A;Master status Registar
            // ;
            // ;The Master Status Register is a 32-bit register that is maintained by the Bus Master.  The
            // ;Bus Master will broadcast (transmit to node <0x03>) this register whenever it changes.  Since
            // ;this is a broadcast message and slave nodes do not respond, it is sent three times with a 250
            // ;millisecond delay between each message.  This is to decrease the possibility of a slave node
            // ;not receiving it.
            // ;
            // ;The Master Status Register:
            // ;
            // ;Bit 31:  Master State
            // ;   1= The Bus Master is running tasks that require data from slave nodes. When this
            // ;   bit is set, and the rotation state match the log requirement in the recorder task
            // ;   record is match, the firmware will put the node into power management mode.
            // ;   0= The Bus Master is not running any tasks which require slave node data.
            // ;   Whenever the slave node receive the MSR with this bit clear, it will shut down the
            // ;   power management function.
            // ;Bit 30:  Flow State
            // ;   1= Flow On has been detected by the Bus Master.
            // ;   0= Flow Off has been detected by the Bus Master.
            // ;Bit 29:  Rotation State
            // ;   1= Rotation has been detected by the Bus Master.
            // ;   0= Rotation has not been detected by the Bus Master.
            // ;Bit 28:  Inclination State
            // ;   1= High Inclination has been detected by the Bus Master.
            // ;   0= Low Inclination has been detected by the Bus Master.
            // ;Bit 27 - Bit 0
            // ;   Unassigned
            // ;Read Master Status Register
            // ;Requests the node transmit its copy of the MSR.
            // ;
            // ;Tx = <msg header> <0xF1> <chksum>
            // ;
            // ;Rx = <msg header> <0xF1> <cmd ack> <slave status> <MSR> <chksum>
            // ;<cmd ack>::= <0x00>
            // ;<MSR>::= <MSByte> <byte> <byte> <LSByte>
            // ;
            // ;
            // ; Write Master Status Register
            // ;Commands the node to update its copy of the MSR and take whatever action is required. This
            // ;command normally is broadcast by the Master node.
            // ;
            // ;Tx = Command
            // ;<msg header> <0xF1> <MSR> <chksum>
            // ;<MSR> ::= <MSByte> <byte> <byte> <LSByte>
            // ;
            // ;Slave nodes do not respond to Broadcast Messages.

            if (response.payload_size() > 3)
            {
                const auto& data = response.payload();
                uint32_t value = 0;
                value |= data.at(0);
                value <<= 8;
                value |= data.at(1);
                value <<= 8;
                value |= data.at(2);
                value <<= 8;
                value |= data.at(3);

                auto txt = QString( "%1" ).arg( value, 0, 16 ).toUpper();
                //// TODO m_setup_statusreg->setText( QStringLiteral("0x") + txt.toUpper() );
                //// TODO QString tip = tr( "Bit 31:  Master State"
                //// TODO                       "   1 = The Bus Master is running tasks that require data from slave nodes. When this\n"
                //// TODO                       "   bit is set, and the rotation state match the log requirement in the recorder task\n"
                //// TODO                       "   record is match, the firmware will put the node into power management mode.\n"
                //// TODO                       "   0 = The Bus Master is not running any tasks which require slave node data.\n"
                //// TODO                       "   Whenever the slave node receive the MSR with this bit clear, it will shut down the\n"
                //// TODO                       "   power management function.\n"
                //// TODO                       "Bit 30:  Flow State\n"
                //// TODO                       "   1 = Flow On has been detected by the Bus Master.\n"
                //// TODO                       "   0 = Flow Off has been detected by the Bus Master.\n"
                //// TODO                       "Bit 29:  Rotation State\n"
                //// TODO                       "   1 = Rotation has been detected by the Bus Master.\n"
                //// TODO                       "   0 = Rotation has not been detected by the Bus Master.\n"
                //// TODO                       "Bit 28:  Inclination State\n"
                //// TODO                       "   1 = High Inclination has been detected by the Bus Master.\n"
                //// TODO                       "   0 = Low Inclination has been detected by the Bus Master.\n"
                //// TODO                       "Bit 27 - Bit 0\n"
                //// TODO                       "   Unassigned\n" );
                //// TODO m_setup_statusreg->setToolTip( tip );

                //// TODO QByteArray ba( "Master Status Reg:" );
                //// TODO ba += txt.toUtf8() + QByteArrayLiteral("\n");
                //// TODO m_terminal->put_data( ba );
                qDebug() << "    Master Status Register:" << QString::number(txt, 16);
                //// m_gui->upload_setup_xxx(value);
            }
            else
            {
                qDebug() << "INCORRECT RESPONSE - expected data size at least 4 but got "
                         << response.payload_size();
            }
            break;
        }

        case 0xf8: // Read Record Task
        {
            // ;Tx = <msg header> <0xF8> <cmd ext> <chksum>
            // ;<cmd ext> ::= <0x01> | <0x05> | <0x06>
            // ;
            // ;Rx = <msg header> <0xF8> <cmd ext> <init delay> <period> <records> <buckets> <log mode> <chksum>
            // ;<cmd ext>  ::= <0x01> | <0x05> | <0x06>
            // ;<init delay>   ::= <MSByte> <LSByte>
            // ;<period>   ::= <MSByte> <LSByte>
            // ;<records>  ::= <byte>
            // ;<buckets>  ::= <byte>
            // ;<log mode> ::= <byte>
            // ;<cmd ack>  ::= <0x00> | <0xFD>
            // ;
            // ;Write Recorder Task
            // ;Tx = <msg header> <0xF8> <cmd ext> <init delay> <period> <records> <buckets> <log mode> <chksum>
            // ;<cmd ext>  ::= <0x01> | <0x05> | <0x06>
            // ;<init delay>   ::= <MSByte> <LSByte>
            // ;<period>   ::= <MSByte> <LSByte>
            // ;<records>  ::= <byte>
            // ;<buckets>  ::= <byte>
            // ;<log mode> ::= <byte>
            // ;
            // ;Rx = <msg header> <0xF8> <cmd ack> <slave status> <chksum>
            // ;<cmd ack> ::= <0x00> | <0xFD>

            //// TODO m_flddiag_rectask_cmd->setText( stuff_cmdhex );
            //// TODO m_flddiag_rectask_ms ->setText( stuff_elapsed_time );

            if (response.payload_size() > 6)
            {
                const auto& data = response.payload();
                auto ext = data.at(0);
                if (ext == 1 || ext == 5 || ext == 6)
                {
                    //<init delay> <period> <records> <buckets> <log mode>
                    ushort initdelay = (data.at(1) << 8) | data.at(2);
                    ushort period    = (data.at(3) << 8) | data.at(4);
                    byte   records   = data.at(5);
                    byte   buckets   = data.at(6);
                    byte   logmode   = data.at(7);

                    //// TODO auto txt = QStringLiteral("<%1> init:%2 period:%3 recs:%4 buckets:%5 log:%6")
                    //// TODO       .arg(ext)
                    //// TODO       .arg(initdelay)
                    //// TODO       .arg(period)
                    //// TODO       .arg(records)
                    //// TODO       .arg(buckets)
                    //// TODO       .arg(logmode);
                    //// TODO QByteArray ba("Record Task: ");
                    //// TODO ba += txt.toUtf8() + QByteArrayLiteral("\n");
                    //// TODO m_terminal->put_data( ba );
                    auto txt = QStringLiteral("[%1] %2s %3s %4 %5 %6")
                               .arg(ext)
                               .arg(initdelay/10.0)
                               .arg(period/10.0)
                               .arg(records)
                               .arg(buckets)
                               .arg(logmode);
                    //// TODO m_flddiag_rectask->setText( txt );

                    //// TODO if( m_flddiag_rectask_log->isChecked() )
                    //// TODO     write_term_protocol_record( txt, -12 );
                    qDebug() << "    Record Task:" << txt;
                }
            }
            else
            {
                qDebug() << "INCORRECT RESPONSE - expected data size at least 7 but got "
                         << response.payload_size();
            }
            break;
        }

        case 0xfc:  // Part Number
        {
            //;Rx = <msg header> <0xFC> <cmd ack> <slave status> <response data> <chksum>
            //;<cmd ack>::= <0x00>
            //;<response data>::= 77557TA100

            set_partnumber(response.payload_string());

            //// m_flddiag_Software_PN->setText(response.payload_string().c_str());
            //// m_flddiag_Software_PN_cmd->setText(cCmdHex);
            //// m_flddiag_Software_PN_ms->setText(cElapsedTime);
            //// QByteArray ba( "Software P/N:" );
            //// ba += response.payload_string().c_str() + QByteArrayLiteral("\n");
            //// m_terminal->put_data( ba );
            //// if (m_flddiag_Software_log->isChecked())
            ////     write_term_protocol_record(response.payload_string().c_str(), -12);

            qDebug("    PartNumber: '%s'", response.payload_string().c_str());
            break;
        }

        default:
            qDebug("%s:: - unregistered cmd: 0x%02X", __FUNCTION__, cmd);
            break;
    }
}

//---------------------------------------------------------

void NodeE4::response_0x01(const Adam::Response &response) // Read Gamma Ray Data
{
    // [01] Read Gamma Ray Data
    // [RTIME]=200
    // [CTYPE]=2
    // ;
    // B CMDEXT,N/A;Command Extention
    // F Gamma,cps;Gamma Ray counts per second
    //
    // ;This command tells the node to transmit gamma ray data.  This data is the average of "n" buckets
    // ;(acquisitions).  The gamma ray returned is IEEE floating point counts per second.  Bucket
    // ;limits are 1 (0x01) to 32 (0x20).  If the bucket count requested is outside the limits, the
    // ;node returns an <0xFD> cmd ack with no data.  If more buckets are requested than what is
    // ;available, the bucket count in the response indicates the number of buckets that were averaged.
    //
    // ;Tx = <msg header> <0x01> <cmd ext> <chksum>
    // ;<cmd ext> ::= <0x01>...<0x20>
    //
    // ;Rx = <msg header> <0x01> <cmd ack> <slave status> <cmd ext> <gamma ray> <chksum>
    // ;<cmd ack> 	::= <0x00> | <0xFD>
    // ;<cmd ext> 	::= <0x01>...<0x20>
    // ;<gamma ray>	::= <IEEE FP>

    if (response.payload_size() < 5)
    {
        qDebug() << "INCORRECT RESPONSE - expected data size at least 5 but got " << response.payload_size();
        return;
    }

    const auto& data = response.payload();
    qint8 ext = data.at(0);
    if( ext >= 1 && ext <= 32 )
    {
        m_gamma_buckets = data.at(0);
        m_gamma_value   = Adam::decode_ieee754(data.data()+1, data.size()-1);

        if (m_gamma_accumulation)
        {
            m_gamma_sum += m_gamma_value;
            ++m_gamma_counter;
            qDebug() << m_gamma_value << " total:" << m_gamma_sum << "cnts:" << m_gamma_counter;
        }

        //// TODO auto txt = QString("[%1] %2").arg( m_gamma_buckets ).arg( m_gamma_value, 0, 'f', 2 );
        //// TODO m_flddiag_gammaCnts->setText( txt );
        //// TODO m_fld_platoCnts->setText( QString::number( m_gamma_value, 'f', 2 ) );
        //// TODO m_setup_GammaCnts->setText( QString::number( m_gamma_value, 'f', 2 ) );
        //// TODO QByteArray ba( "Cnts: " );
        //// TODO ba += txt.toUtf8() + QByteArrayLiteral("\n");
        //// TODO m_terminal->put_data( ba );
        //// TODO if( m_flddiag_gammaCnts_log->isChecked() )
        //// TODO {
        //// TODO     write_term_protocol_record( QString::number( m_gamma_buckets ), -12 );
        //// TODO     write_term_protocol_record( QString::number( m_gamma_value, 'f', 2 ), -12 );
        //// TODO }
        qDebug() << "    gamma:" << m_gamma_buckets << m_gamma_value
                 << "total:" << m_gamma_sum << "cnts:" << m_gamma_counter;
    }

}

void NodeE4::response_0x05(const Adam::Response &response) // Read Temperature Data
{
    // [05] Read Temperature Data
    // [RTIME]=200
    // [CTYPE]=2
    // ;
    // B CMDEXT,N/A;Command Extention
    // F Temp,deg C;temperature of the SRIG
    // ;
    // ;This command tells the node to transmit the internal temperature of the SRIG based on "n"
    // ;buckets of acquisitions (averaged).  One acquisition is the average of four analogs to digital
    // ;conversions.  The temperature returned is IEEE floating point degrees Celsius.  Bucket limit
    // ;is 1.  If the bucket count is outside the limit, the node returns an <0xFD> cmd ack with no data.
    // ;
    // ;Tx = <msg header> <0x05> <cmd ext> <chksum>
    // ;<cmd ext> ::= <0x01>
    // ;
    // ;Rx = <msg header> <0x05> <cmd ack> <slave status> <cmd ext> <temperature> <chksum>
    // ;<cmd ack> ::= <0x00> | <0xFB> | <0xFD>
    // ;<cmd ext> ::= <0x01>
    // ;<temperature> ::= <IEEE FP>
    // "fce4 000f 05 00 0000 01 41f2fc90 04b4"

    //// TODO m_flddiag_Temperature_cmd->setText( stuff_cmdhex );
