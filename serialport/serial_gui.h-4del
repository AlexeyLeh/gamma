#ifndef __SERIALPORT_GUI_H_
#define __SERIALPORT_GUI_H_

#include <QGroupBox>
#include <QComboBox>
#include <QLabel>
#include <QPushButton>
#include <QCheckBox>
#include <QSerialPort>
#include <QSerialPortInfo>

#include "comport_t.h"

class BTO;
//// class port_t;

class SERIALPORT_GUI : public QWidget
{
   Q_OBJECT;

public:

   SERIALPORT_GUI();
   ~SERIALPORT_GUI();

   const QList<QSerialPortInfo>& ports_list() const;
   const comport_t& port_settings();
   void set_port_settings(const comport_t& port);

private slots:
   void slot_get_port_list();
   void slot_port_changed(int index);
   void slot_checkCustomBaudRatePolicy(int index);

private:
   void create_fields_layout();
   void set_form_values();

private:
   QGroupBox        *m_selectBox;
   QComboBox        *m_serialportList;
   QLabel           *m_descriptionLabel;
   QLabel           *m_manufacturerLabel;
   QLabel           *m_serialNumberLabel;
   QLabel           *m_locationLabel;
   QLabel           *m_vidLabel;
   QLabel           *m_pidLabel;

   QGroupBox        *m_parametersBox;
   QLabel           *m_baudRateLabel;
   QLabel           *m_dataBitsLabel;
   QLabel           *m_parityLabel;
   QLabel           *m_stopBitsLabel;
   QLabel           *m_flowCtrlLabel;

   QComboBox        *m_baudRateBox;
   QComboBox        *m_dataBitsBox;
   QComboBox        *m_parityBox;
   QComboBox        *m_stopBitsBox;
   QComboBox        *m_flowCtrlBox;

   QPushButton      *m_refreshButton;
   QCheckBox        *m_localEchoCheckBox;

   comport_t         m_port_settings;  // выбранные параметры
   QList<QSerialPortInfo> m_serialport_info_list;
   QIntValidator    *m_intValidator;   // проверка на тип - число
};

